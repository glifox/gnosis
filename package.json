{
  "private": false,
  "name": "@glifox/gnosis",
  "version": "0.1.1",
  "author": "feraxhp",
  "license": "MIT",
  "type": "module",
  "main": "dist/gnosis.cjs",
  "module": "dist/gnosis.mjs",
  "types": "./dist/gnosis.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gnosis.d.ts",
      "import": "./dist/gnosis.mjs",
      "require": "./dist/gnosis.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glifox/gnosis.git"
  },
  "bugs": {
    "url": "https://github.com/glifox/gnosis/issues"
  },
  "homepage": "https://gnosis.feraxhp.com/",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@feraxjs/themes-codemirror": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "rolldown": "^1.2.16",
    "rolldown-plugin-dts": "^0.29.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "rm -fr dist && rolldown -c",
    "prev": "bun ./example/index.html",
    "test": "playwright test",
    "lock": "pnpm install && pnpm --dir web install && pnpm install --frozen-lockfile && pnpm --dir web install --frozen-lockfile",
    "web:prev": "cd web && bun run prev",
    "web:build": "pnpm run build && cd web && pnpm run build"
  },
  "keywords": [
    "WYSIWYG",
    "markdown",
    "editor",
    "codemirror",
    "extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.0.9",
  "peerDependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "codemirror": "^6.0.2"
  }
}
